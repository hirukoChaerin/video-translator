# ==========================================
# Subtitulador - .gitignore del monorepo
# ==========================================

# ---------- Secretos y configuración local ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Node.js (api-gateway y frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Builds del frontend (Vite)
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---------- Python (worker) ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/

# Modelos descargados (Whisper / Argos): pesan GB, nunca van al repo
.cache/
*.argosmodel

# ---------- Archivos de usuario (videos subidos y resultados) ----------
storage/uploads/*
storage/outputs/*
!storage/uploads/.gitkeep
!storage/outputs/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.srt
*.vtt

# ---------- Docker ----------
docker-compose.override.yml

# ---------- IDEs y editores ----------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs y temporales ----------
logs/
*.log
tmp/
temp/
