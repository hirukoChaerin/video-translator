# ---- Comunes ----
NODE_ENV=production
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_NAME=video-translation

# ---- API Gateway ----
PORT=4000
MAX_UPLOAD_MB=10240
CORS_ORIGIN=http://localhost:5173
# Token compartido para el callback interno worker -> api
INTERNAL_TOKEN=cambia-este-token-en-produccion

# ---- Worker Python ----
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto            # auto | cuda | cpu  (cuda = transcribir en GPU)
WHISPER_COMPUTE_TYPE=auto      # float16 (GPU) | int8 (CPU) | auto
VIDEO_ENCODER=libx264          # libx264 (CPU) | h264_nvenc (GPU NVIDIA)
TARGET_LANGUAGE=es
BURN_SUBTITLES=true            # true = video con subtítulos incrustados, false = solo .srt/.vtt
WORKER_CONCURRENCY=1           # subir solo si hay GPU/CPU de sobra
